# Injected automatically by Render when using render.yaml — set manually for local dev
DATABASE_URL=postgres://user:password@localhost:5432/reps_standing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

# Optional, for later — not required for v1
RESEND_API_KEY=
EMAIL_FROM=
